# Crafted Barbers Supabase & Paystack Environment Configuration

# Client-side configuration (safe for client bundle)
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Server-side configuration for Supabase Edge Functions (Never expose in mobile app bundle)
# Set these in your Supabase Dashboard under: Settings > Edge Functions > Secrets
# PAYSTACK_SECRET_KEY=sk_test_your_secret_key_here
# SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here
